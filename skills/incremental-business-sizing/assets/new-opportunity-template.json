      "evidence": "",
      "value": null
    },
    {
      "id": "revenue",
      "label": "＝ 增量收入",
      "unit": "填写币种单位",
      "format": "money:1",
      "role": "calculation",
      "key": true,
      "indent": 0,
      "comment": "",
      "evidence": "",
      "expression": "units*unit_price"
    },
    {
      "id": "profit_section",
      "label": "盈利桥",
      "unit": "",
      "format": "decimal:1",
      "role": "section",
      "key": false,
      "indent": 0,
      "comment": "",
      "evidence": ""
    },
    {
      "id": "oi_margin",
      "label": "× 增量经营利润率",
      "unit": "ratio",
      "format": "percent:1",
      "role": "input",
      "key": false,
      "indent": 0,
      "comment": "明确推理、人工、折旧、研发、分成等成本边界",
      "evidence": "",
      "value": null
    },
    {
      "id": "incremental_oi",
      "label": "＝ 增量经营利润",
      "unit": "填写币种单位",
      "format": "money:1",
      "role": "calculation",
      "key": true,
      "indent": 0,
      "comment": "",
      "evidence": "",
      "expression": "revenue*oi_margin"
    },
    {
      "id": "tax_rate",
      "label": "× 有效税率",
      "unit": "ratio",
      "format": "percent:1",
      "role": "input",
      "key": false,
      "indent": 0,
      "comment": "",
      "evidence": "",
      "value": null,
      "min": 0,
      "max": 1
    },
    {
      "id": "shares",
      "label": "÷ 同期摊薄股数",
      "unit": "与币种金额匹配的股数单位",
      "format": "integer",
      "role": "input",
      "key": false,
      "indent": 0,
      "comment": "",
      "evidence": "",
      "value": null
    },
    {
      "id": "incremental_eps",
      "label": "＝ 增量 EPS",
      "unit": "填写币种/股",
      "format": "eps:2",
      "role": "calculation",
      "key": true,
      "indent": 0,
      "comment": "",
      "evidence": "",
      "expression": "incremental_oi*(1-tax_rate)/shares"
    }
  ],
  "required_results": [
    "revenue",
    "incremental_oi",
    "incremental_eps"
  ],
  "footnotes": [
